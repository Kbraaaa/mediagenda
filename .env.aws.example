# Variables para la instancia EC2 (copiar como .env en el servidor; nunca se sube a GitHub).
DB_USER=postgres
DB_PASSWORD=pon-una-clave-larga

AWS_REGION=us-east-2
# URL de la cola SQS de eventos (consola de SQS -> mediagenda-eventos -> URL)
SQS_COLA_URL=https://sqs.us-east-2.amazonaws.com/TU_ID_DE_CUENTA/mediagenda-eventos
# Correo verificado en Amazon SES (en modo sandbox, los destinatarios tambien deben estar verificados)
CORREO_REMITENTE=tu-correo-verificado@gmail.com

GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.5-flash-lite

# SMS por Amazon SNS: bloqueado en la cuenta del plan gratuito, por eso queda simulado.
# Con una cuenta que lo permita y el celular verificado en el sandbox de SNS: SMS=sns
SMS=simulado

# Aviso al celular por Telegram (configurar-telegram.bat llena estos valores). El token es SECRETO.
# SMS=telegram
TELEGRAM_TOKEN=8639538979:AAHfTU0yVSmJV_eBNpMXO9US_wDo0Gnz07M
TELEGRAM_CHAT_ID=
