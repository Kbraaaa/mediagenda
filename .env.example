# Copia este archivo como .env (no se sube a GitHub) y cambia los valores.

# PostgreSQL (lo levanta docker compose, en local y en AWS)
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=cambia-esta-clave

# RabbitMQ
RABBIT_HOST=rabbitmq
RABBIT_USER=mediagenda
RABBIT_PASSWORD=cambia-esta-clave

# Gemini (Google AI Studio) - lo usa ms-citas para el triage
GEMINI_API_KEY=
# Modelo de Gemini (probado: responde en ~1 s con la capa gratuita)
GEMINI_MODELO=gemini-3.5-flash-lite

# Correo (ms-notificaciones). En local se usa Mailpit y no hay que cambiar nada.
# Para AWS se usa .env.aws.example (SQS + SES, sin claves SMTP).

# Aviso al celular por Telegram (configurar-telegram.bat llena estos valores). El token es SECRETO.
# SMS=telegram
TELEGRAM_TOKEN=pega-aqui-el-token-de-BotFather
TELEGRAM_CHAT_ID=
